{
  "manifest_version": 3,
  "name": "Gemini AI Salesforce Automation",
  "version": "1.0.0",
  "description": "AI-powered Salesforce automation using Google Gemini",
  
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage"
  ],
  
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini AI Salesforce Automation"
  },
  
 
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
