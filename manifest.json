{
  "manifest_version": 3,
  "name": "Gemini AI Salesforce Automation",
  "version": "1.0.0",
  "description": "AI-powered Salesforce automation using Google Gemini",
  
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "downloads",
    "storage"
  ],
  
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.salesforce.com/*", "*://*.force.com/*","https://*.lightning.force.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini AI Salesforce Automation"
  },
  
 "web_accessible_resources": [
    {
      "resources": ["*.js", "*.css"],
      "matches": ["*://*.salesforce.com/*", "*://*.force.com/*","https://*.lightning.force.com/*"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com;"
  }
}
